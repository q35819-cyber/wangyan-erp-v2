# 网研ERP 第一阶段公网内测生产环境示例
# 只允许填写占位配置，不得把真实 Secret 提交到仓库。
NODE_ENV=production
ERP_HOST=127.0.0.1
ERP_PORT=8765
ERP_TRUST_PROXY=1
PUBLIC_ORIGIN=https://erp.example.com

# 以下目录必须位于应用发布目录之外。
ERP_DATA_DIR=D:\\sample-erp-data\\data
ERP_PRIVATE_OBJECT_DIR=D:\\sample-erp-data\\private-objects
ERP_BACKUP_DIR=E:\\sample-erp-backups
ERP_BACKUP_REPLICA_DIR=\\\\backup-host\\sample-erp-backups
ERP_BACKUP_REPLICA_CLASS=remote-machine
ERP_RUNTIME_LOG_DIR=D:\\sample-erp-data\\logs

# Secret 由部署环境/Secret 文件注入；不要在本文件填写真实值。
ERP_CSRF_SECRET=<INJECT_AT_DEPLOY_TIME>
ERP_CREDENTIALS_KEY_FILE=D:\\sample-erp-secrets\\credentials.key
DATABASE_URL=<INJECT_AT_DEPLOY_TIME>
DATABASE_MIGRATION_URL=<INJECT_AT_DEPLOY_TIME>

# 接口监控、账号安全和 BUG 告警共用 SMTP；真实密码只在部署时注入。
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BUG_REPORT_EMAIL=

# 第一阶段公网内测默认关闭商业化与自动处罚。
ERP_PUBLIC_LAUNCH=0
ERP_CHARGING_ENABLED=0
ERP_AGENT_AUTO_PENALTY=0
ERP_LEGACY_JSON_LAZY_IMPORT=0
