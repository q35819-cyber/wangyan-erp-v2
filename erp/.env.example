# Web application
NODE_ENV=development
ERP_HOST=127.0.0.1
ERP_PORT=8765
PUBLIC_ORIGIN=http://127.0.0.1:8765
# 仅同机 Nginx/Caddy 覆盖 X-Forwarded-For 后设为 1；多值或非法头会回退 TCP 对端地址。
# ERP_TRUST_PROXY=1
# Production requires a unique random value of at least 32 characters.
# ERP_CSRF_SECRET=inject-with-a-local-secret-manager

# Payment evidence private storage. Keep this key separate from shop credentials.
# Accepts 64 hexadecimal characters or canonical Base64 for exactly 32 bytes.
# ERP_PRIVATE_OBJECT_DIR=<YOUR_PRIVATE_DATA_DIRECTORY>
# ERP_PRIVATE_OBJECT_KEY=inject-with-a-local-secret-manager

# PostgreSQL runtime connection. Never commit real passwords.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=wyerp_dev
PGUSER=wyerp_app
# PGPASSWORD=inject-with-a-local-secret-manager

# Optional separate owner used only by migration commands.
PGMIGRATIONUSER=wyerp_migrator
# PGMIGRATIONPASSWORD=inject-with-a-local-secret-manager

# Development may set disable only when PostgreSQL listens on loopback.
# Production must use verify-full with a trusted CA.
PGSSLMODE=disable

# Optional QQ SMTP settings. Never put real credentials in this example file.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BUG_REPORT_EMAIL=

# AI 出站防护：默认拒绝解析到内网/保留网段的地址。
# 仅当本机代理以 fake-ip/TUN 模式把公网域名解析到 198.18.0.0/15 或 100.64.0.0/10 时，才在开发机设为 1。
# 该开关只放行这两个网段，127.0.0.0/8、10/8、172.16/12、192.168/16、169.254/16 仍一律拒绝。生产环境必须保持关闭。
